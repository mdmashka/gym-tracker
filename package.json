{
  "name": "telegram-gym-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src supabase/functions tests eslint.config.js vitest.config.ts playwright.config.ts",
    "import:legacy": "node scripts/import-legacy.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run check:backend && npm test && npm run build && npm run test:browser",
    "check:backend": "deno check --frozen --lock=deno.lock supabase/functions/api/index.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "jszip": "^3.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "deno": "^2.9.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
